dist/
unpackage/
mp-weixin-dist-r*/
mp-alipay-dist*/
mp-baidu-dist*/
mp-toutiao-dist*/
app-dist*/

# ============================================================
# 打包/发布产物
# ============================================================
release-apk/
*.apk
*.wgt
*.ipa

# ============================================================
# 截图 / 渲染图（UI 验收与效果预览，非源码）
# ============================================================
screenshots/
实况截图/
*-预览.png
*-复刻.png
*-对比.png

# ============================================================
# 日志 / 临时文件
# ============================================================
.tmp/
*.log
.workbuddy-*.log

# ============================================================
# 编辑器 / 系统
# ============================================================
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ============================================================
# Python 编译产物
# ============================================================
__pycache__/
*.pyc
*.pyo

# ============================================================
# 备份与退役文件（形如 xxx.py.bak-20260925 / xxx.retired-20261004）
# ============================================================
*.bak
*.bak-*
*.retired-*
*.orig

# ============================================================
# 测试 / 验收 / 诊断 / 一次性维护脚本（不随仓库发布）
#   scripts/ 下只保留构建与部署工具（deploy / toolchain / sshtarget /
#   remote / livecreds / publish-wgt / *-icons / serve-dist / esm-js-resolver）
# ============================================================
scripts/check-*
scripts/probe-*
scripts/verify-*
scripts/audit-*
scripts/test-*
scripts/round*
scripts/live-*
scripts/run-*
scripts/status-*
scripts/diag-*
scripts/dump-*
scripts/extract-*
scripts/rewrite-*
scripts/mp-snapshot*
scripts/add-tap-feedback*
scripts/backfill-*
scripts/clear-test-*
scripts/remote.py.bak*
scripts/_*
scripts/.deploy-matrix-state.json

# 本地私密配置（如有）
.env
.env.local
scripts/livecreds.local*
